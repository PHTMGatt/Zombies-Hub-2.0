{
  "name": "zombies-hub-2.0",
  "private": true,
  "overrides": {
    "compression": "^1.8.2"
  },
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/mob-browser-smoke.mjs && node scripts/shadows-browser-smoke.mjs && node scripts/der-browser-smoke.mjs && node scripts/zets-browser-smoke.mjs && node scripts/gorod-browser-smoke.mjs && node scripts/revelations-browser-smoke.mjs",
    "dev": "vite",
    "check": "node scripts/verify.mjs",
    "compile": "vite build && node scripts/write-build-info.mjs",
    "build": "npm run check && npm run compile",
    "ci": "npm run build",
    "preview": "vite preview",
    "start": "serve -s dist",
    "smoke": "node scripts/smoke-live.mjs",
    "render": "npm ci --include=dev --no-audit --no-fund && npm run ci",
    "render-build": "npm run render"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "react-youtube": "^10.1.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.59.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.5"
  }
}
